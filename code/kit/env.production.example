# Production .env of the two-node GB10 deployment (2026-10-05 17:30, the configuration behind the headline numbers),
# with secrets removed and host-specific values replaced. Copy to <launcher>/.env on the HEAD node, then edit the
# lines marked EDIT. Every switch is explained in REPRODUCE.md section 'Configuration reference'.
# The two env.r16 features production turned off (GLM53_DEC_FP8ROOF, GLM53_DEC_MOEGLUE_WARM) are absent on purpose:
# apply_r16.sh adds every env.r16 line on a fresh install, so run tools/env_r16.sh off fp8roof / off moeglue after it.

HEAD_IP=10.0.100.2   # EDIT: head address on the first CX7 rail (NCCL bootstrap / master)
WORKER_IP=10.0.100.3   # EDIT: worker address on the same rail
WORKER_USER=CHANGE_ME   # EDIT: login on the worker (passwordless ssh from the head)
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1,roceP2p1s0f0
WORKER_CX7_IB=rocep1s0f1,roceP2p1s0f0
MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold
MODEL_FALLBACK=Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold
MODEL_REVISION=6c5b28260ab9e80c6608de8b419e624cbe71b7cf
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor
PORT=8888
TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
EXL3_FAT_KERNEL=1
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
MTP_TOKENS=2
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEM_UTIL=0.87
EXTRA_ARGS="--enable-prompt-tokens-details --override-generation-config {\"temperature\":1.0,\"top_p\":0.95,\"repetition_penalty\":1.05,\"eos_token_id\":[154820,154827,154829]} --default-chat-template-kwargs {\"reasoning_effort_placement\":\"before_first_user\"}"
SM90_KV=1
KV_CACHE_BYTES=16106127360
KV_CACHE_DTYPE=fp8
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":64,"video":1}'
ABLIT=1
ABLIT_METHOD=auto
ABLIT_DIRECTION=dealign
ABLIT_LAYERS=15-45
ABLIT_ALPHA=3.0
ABLIT_INCLUDE_MTP=1
GLM53_BOOT_SHAPE_WARMUP=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_SPINWAIT_MS=16
USE_HOST_NCCL=0
NCCL_SO_NAME=libnccl.so.2.30.7
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3
CG_ESTIMATE=0
NCCL_DEBUG=WARN
VLLM_API_KEY=   # EDIT: set a long random value; clients send it as a Bearer token
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=256
GLM53_ADAPTIVE_K=ema
GLM53_ADAPTIVE_K_SET=4,5,7
GLM53_ADAPTIVE_K_MARGIN=1.0
GLM53_ADAPTIVE_K_ALPHA=0.25
GLM53_DENSE_FP8=dense,kda,mla,shared
GLM53_APC_RETENTION_INTERVAL=32256
GLM53_APC_RETENTION_INTERVAL_SWA=0
TF_EXL3_MOE=1
GLM53_SPEC_RESAMPLE_INDEPENDENT=1
GLM53_DRAFT_FP8=layers,fc
GLM53_DRAFT_LMHEAD_FP8=
GLM53_MEM_HYGIENE=1
GLM53_TF_PROFILE=/tmp/glm53-prof
NCCL_NCHANNELS=8
GLM53_MEMPREP=1
GLM53_LMHEAD_FP8=1
GLM53_FP8_GEMV=1
GLM53_FP8_GEMV_MAX_M=16
GLM53_BF16_GEMV=1
GLM53_BF16_GEMV_DEDUP_ROUTER=1
GLM53_PREFILL_FUSED_CAP=1
GLM53_KPOOL_SEED_STRIDE=1
NCCL_TUNER_PLUGIN=
NCCL_TUNER_CONFIG_FILE=
NCCL_IB_MERGE_NICS=0
GLM53_FP8_LARGE_M=1
GLM53_DEC_SMALLOPS=1
GLM53_DEC_SMALLOPS_KINDS=dconv
GLM53_DRAFT_KV_COMPACT=1
GLM53_APC_DRAFTER_LOW_PRIORITY=0
GLM53_PREFILL_QUICKWINS=all
GLM53_MLA_PREFILL=1
GLM53_REJECTION_METHOD=block
GLM53_KPOOL_RING=1
GLM53_DEC_HOSTLOOP=1
GLM53_DEC_HOSTLOOP_WAKE=auto
GLM53_KDA_STRIDED_QKV=1
GLM53_KDA_FLASHKDA=1
GLM53_MHC_SP=1
GLM53_MOE_E4M3=1
GLM53_DENSE_W8A8=1
GLM53_DENSE_W8A8_ONLY=kda.in_proj_qkvbfg_a,mla.o_proj
GLM53_MOE_E4M3_MAINLOOP=1
GLM53_MOE_E4M3_ACC=bf16
GLM53_MOE_E4M3_FOLD_SHARED=1
GLM53_MHC_FUSED=1
GLM53_DENSE_W8A8_FP8AG=1
MODEL_CACHE_NAME=models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold
MODEL_FALLBACK_CACHE_NAME=models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold
EXPECTED_SHARDS=83
GLM53_DEC_KDA_LAZY=1
GLM53_KPOOL_TAIL_POSITIONS=2
GLM53_DEC_DLMH=1
GLM53_DEC_AR1SHOT=1
GLM53_MLA_PLAN_PIN=1
GLM53_SPEC_VTRIM=on
GLM53_SPEC_VTRIM_TAU=0.3
