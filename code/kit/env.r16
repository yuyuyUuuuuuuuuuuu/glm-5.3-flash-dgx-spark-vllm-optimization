# deploy-r16: lines to ADD to nodeA ~/GLM-5.3-Flash-EXL3-2x-DGX-Sparks/.env (keep every existing line; production
# already has TF_EXL3_MOE=1, GLM53_FP8_GEMV=1 and GLM53_KPOOL_SEED_STRIDE=1, which these require).
# The new start.sh forwards each GLM53_* name below to BOTH ranks. Env-only revert of one feature = delete its line(s)
# with tools/env_r16.sh off <feature> and restart both ranks; see ROLLOUT.md section 5. Do not set a line EMPTY:
# start.sh refuses an empty GLM53_DRAFT_KV_COMPACT / GLM53_APC_DRAFTER_LOW_PRIORITY (0 or 1 only), and restart2.sh
# has already stopped both ranks when start.sh validates; an empty GLM53_DEC_SMALLOPS_KINDS means EVERY kind (+66.75 MiB).
# -- TF bundle (tf-exl3-fork deploy-r16)
GLM53_PREFILL_QUICKWINS=all
GLM53_MLA_PREFILL=1
GLM53_DEC_FP8ROOF=1
GLM53_DEC_MOEGLUE_WARM=1
GLM53_DEC_HOSTLOOP=1
GLM53_DEC_SMALLOPS=1
GLM53_DEC_SMALLOPS_KINDS=dconv
GLM53_KPOOL_RING=1
# -- launcher APC short-suffix fix (tf-exl3-launcher-apc main; GLM53_APC_PRIOR_CHECKPOINT stays at its default 0)
GLM53_DRAFT_KV_COMPACT=1
GLM53_APC_DRAFTER_LOW_PRIORITY=0
# -- operator switch (r16j, blockverify; docs/BLOCK_VERIFY.md): NOT a line to add. apply_r16.sh never writes it, so the
#    switch stays unset = standard (today's --speculative-config byte for byte). The kit's start.sh forwards it to both
#    ranks and validates it; the operator sets it for the B arm of ROLLOUT.md (tools/env_r16.sh on blockverify writes
#    GLM53_REJECTION_METHOD=block after checking its prerequisites; off removes it); revert_r16.sh removes it with the
#    env.r16 lines. Format `#switch NAME values`: read by apply_r16 / revert_r16 / env_r16 / boot_checks / kit_chain.
#switch GLM53_REJECTION_METHOD standard|block
# -- operator switch (r16k, kdaqkv; docs/KDA_STRIDED_QKV.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = stock (the KDA recurrent decode keeps its four .contiguous() copies per layer per step). The kit's
#    start.sh (r16k) forwards it to both ranks and validates it (empty/0/1; 1 also needs the overlay file and a bundle
#    script that runs it); tools/env_r16.sh on kdaqkv writes GLM53_KDA_STRIDED_QKV=1 after checking that the installed
#    start.sh forwards it (an r16j start.sh does not: the line would be silently ignored); off removes it.
#switch GLM53_KDA_STRIDED_QKV 0|1
# -- per-step decode tracer (glm53_dectrace.py, docs/DEC_HOSTGAP.md §3): measurement-only, deliberately NOT a value line
#    above (apply_r16.sh must never turn it on). `tools/env_r16.sh on trace` writes
#    GLM53_DEC_TRACE=/root/.cache/vllm/glm53-dectrace (the vLLM cache dir both containers bind-mount from their host) and
#    GLM53_DEC_TRACE_MAX_STEPS=20000, and REFUSES with .env unchanged unless the installed start.sh forwards both names
#    to both ranks: the r16j start.sh does not (it needs the names in make_start_sh.py KNOBS_DEFAULT and a new kit).
#    `tools/env_r16.sh off trace` removes every GLM53_DEC_TRACE* line. Knobs, all unset = inert:
#      GLM53_DEC_TRACE=<dir>          one <dir>/dectrace-rank<R>-pid<PID>.ndjson per rank (truncated at boot)
#      GLM53_DEC_TRACE_RING=<n>       records kept in memory before a flush (default 4096)
#      GLM53_DEC_TRACE_FLUSH=<n>      also flush every n steps (default 64)
#      GLM53_DEC_TRACE_MAX_STEPS=<n>  stop after n steps, closing the file (default 20000; 0 = unlimited)
#      GLM53_DEC_TRACE_EVENTS=<csv>   keep only these event names ("-name" drops one)
#      GLM53_DEC_TRACE_GPU=0          no CUDA-event timing of the eager collectives (default on)
#    Both ranks need the same values. Analysis: tests/align_dectrace.py <rank0 file> <rank1 file>.
#    r16k: the kit does NOT ship glm53_dectrace (setup.py py_modules / integrate.py stay r16j's, so the composed tree
#    with every knob unset is r16j's byte for byte); the module stays in the repo for a measurement kit.
# -- operator switch (r16l, kpooldown; docs/KPOOL_DROP_LOWEST.md): NOT a line to add. apply_r16.sh never writes it,
#    so it stays unset = stock (the kpool indexer keeps production's last-column truncation of the top-k pools, which
#    drops an ARBITRARY pool per run: the top-k ops return a deterministic SET in a nondeterministic ORDER). The kit's
#    start.sh (r16l) forwards it to both ranks and validates it (empty/0/1; 1 also needs the overlay file and a bundle
#    script that runs it); tools/env_r16.sh on kpooldown writes GLM53_KPOOL_DROP_LOWEST=1 after checking that the
#    installed start.sh forwards it (an r16k start.sh does not: the line would be silently ignored); off removes it.
#switch GLM53_KPOOL_DROP_LOWEST 0|1
# -- operator switch (r16n, flashkda; docs/KDA_FLASHKDA.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = stock (the KDA chunked prefill keeps the Triton chunk_kda_with_fused_gate chain and the
#    _flashkda_fp32_C extension is not installed either: production bytes). The kit's start.sh (r16n) forwards it to
#    both ranks and validates it (empty/0/1; 1 also needs the overlay file and a bundle script that runs it);
#    tools/env_r16.sh on flashkda writes GLM53_KDA_FLASHKDA=1 after checking that the installed start.sh forwards it
#    (an r16l start.sh does not: the line would be silently ignored); off removes it. When it is on each rank holds
#    ~0.5-0.6 GiB of FlashKDA workspace buffers (sized from max_num_batched_tokens/max_num_seqs, RESERVED at boot); the recurrent-state
#    dtype stays fp32 and the decode path is untouched.
#switch GLM53_KDA_FLASHKDA 0|1
# -- operator switch (r16msp, mhcsp; docs/MHC_SP.md): NOT a line to add. apply_r16.sh never writes it, so it stays
#    unset = stock (production byte-identical: the mHC bookkeeping runs on the full batch on both ranks, one
#    all-reduce after attention and one after the MLP). The kit's start.sh (r16msp) forwards it to both ranks and
#    validates it (empty/0/1; 1 also needs the overlay file and a bundle script that runs it); tools/env_r16.sh on
#    mhcsp writes GLM53_MHC_SP=1 after checking that the installed start.sh forwards it (an r16l start.sh does not:
#    the line would be silently ignored); off removes it.
#switch GLM53_MHC_SP 0|1
# -- operator switch (r16e4, moee4m3; docs/MOE_E4M3.md): NOT a line to add. apply_r16.sh never writes it, so it stays
#    unset = stock (production's prefill routed-MoE kernels; the bundle does not run patch_moe_e4m3.py, so nothing of
#    the feature reaches site-packages and the composed tree is the previous kit's byte for byte). The kit's start.sh
#    (r16e4) forwards it to both ranks and validates it (empty/0/1; 1 also needs overlay/tf/overlay/{patch_moe_e4m3.py,
#    glm53_moe_e4m3.py, glm53_moe_e4m3_ext.cpython-312-aarch64-linux-gnu.so} and a bundle script that runs the patch);
#    tools/env_r16.sh on moee4m3 writes GLM53_MOE_E4M3=1 after checking that the installed start.sh forwards it (an
#    r16l start.sh does not: the line would be silently ignored); off removes it. Ship only after the e4m3 KL
#    measurement (moefq emulation, with its weight-cache bug fixed) accepts the numerics.
#switch GLM53_MOE_E4M3 0|1
# -- operator switch (w8a8; docs/DENSE_W8A8.md): NOT a line to add. apply_r16.sh never writes it, so it stays
#    unset = stock (production's W8A16/Marlin dense path; the W8A8 module is not even in site-packages). The kit's
#    start.sh forwards it to BOTH ranks (head -e, worker serve_env_names); tools/env_r16.sh on w8a8 writes
#    GLM53_DENSE_W8A8=1 after checking that the installed start.sh forwards it and the bundle carries
#    patch_dense_w8a8.py + fp8_w8a8.py + the tf_fp8_w8a8_ext AOT kernel; off removes the line. PER-TOKEN FP8
#    ACTIVATIONS: read DENSE_W8A8.md 4 (numerics + gates) before turning it on.
#switch GLM53_DENSE_W8A8 0|1
# -- operator switch (r16z, fkda-v; docs/KDA_FLASHKDA3.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = the SHIPPED r16x FlashKDA build (production's bytes today: the overlay stages
#    glm53_flashkda.py + _flashkda_fp32_C.abi3.so, the kda.py call without out=; only read when
#    GLM53_KDA_FLASHKDA=1). The kit's start.sh (r16z) forwards it to BOTH ranks and validates it (unset/1/2/3;
#    2 needs overlay/{glm53_flashkda2.py,_flashkda_fp32_C2.abi3.so} = the fkda2 precision build, 3 needs
#    overlay/{glm53_flashkda3.py,_flashkda_fp32_C3.abi3.so} = the fkda3 build; each wrapper pins its extension
#    sha at boot). Switching the build on an installed tree is REFUSED by the patch (byte mismatch): set
#    GLM53_KDA_FLASHKDA=0, restart once, then set =1 with the new value and restart again.
#switch GLM53_KDA_FLASHKDA_V 1|2|3
# -- operator switch (r16z, mhcsp2; docs/MHC_SP2.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = the r16x SP result (GLM53_MHC_SP alone). The kit's start.sh (r16z) forwards it to BOTH ranks
#    and validates it (empty/0/1; 1 REFUSED without GLM53_MHC_SP=1 - the pipelined SP extends the r16x SP patch
#    of the same model.py, a rank mismatch = the paired-collective corruption of mhcsp D-A; 1 also needs
#    overlay/tf/overlay/patch_mhc_sp2.py and a bundle script that runs it); tools/env_r16.sh on mhcsp2 checks
#    all of that with .env unchanged on refusal. Like mhcsp, it is a PAIRED collective: boot_checks refuses
#    traffic unless BOTH ranks' logs carry the sp2 patched line.
#switch GLM53_MHC_SP2 0|1
# -- operator switch (r16z2, w8a82; docs/DENSE_W8A8_2.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = custom (the kit's tf_fp8_w8a8_ext VERSION 2 CUTLASS SM120 persistent GEMM: bitwise ==
#    cutlass_scaled_mm, checked per shape at load, a failing shape falls back to cutlass_mm on its own); the only
#    other value, cutlass_mm, serves the image's cutlass_scaled_mm in pieces (the w8a8 path). Only read when
#    GLM53_DENSE_W8A8=1. The kit's start.sh (r16z2) forwards it to BOTH ranks and validates it (unset/custom/
#    cutlass_mm; both values need the r16z2 overlay fp8_w8a8.py that reads the knob).
#switch GLM53_DENSE_W8A8_GEMM custom|cutlass_mm
# -- operator knob (r16z2, w8a82; docs/DENSE_W8A8_2.md): NOT a #switch (the value is a free-form comma list, which
#    apply_r16's enum check cannot parse). unset = every served projection (the w8a8 behaviour); else a comma list of
#    "<group>.<projection>" from fp8_w8a8.py's PROJ_NAMES - kda.in_proj_qkvbfg_a, kda.o_proj, mla.fused_qkv_a_proj,
#    mla.q_b_proj, mla.o_proj, shared.gate_up_proj, shared.down_proj, dense.gate_up_proj, dense.down_proj (the
#    production A/B dial: kda.in_proj_qkvbfg_a,mla.o_proj carries ~65 % of the saving through 45 of the 192 GEMMs per
#    chunk; the subset's KL vs prod-FP8 was 0.00132 vs the all-projections 0.00427). Only read when
#    GLM53_DENSE_W8A8=1. The kit's start.sh (r16z2) forwards it to BOTH ranks and validates every name against that
#    set; the r16z2 boot_checks compare the two ranks' values.
#knob GLM53_DENSE_W8A8_ONLY unset|comma-list-of-PROJ_NAMES
# -- operator switch (r16z2, moe2; docs/MOE2.md): NOT a line to add. apply_r16.sh never writes it, so it stays
#    unset = e4m3 (the down projection on e4m3 too, the original r16x spec). f16 = the fused variant 16: gate/up on
#    e4m3, the down projection on production's operand widths (fp16 rotated input x fp16 trellis decode, fp32
#    accumulate; removes 2 of the 4 e4m3 roundings, error vs production 6.51 % -> 5.34 %, +1.5-3.9 ms per
#    13,824-token layer call). Only read when GLM53_MOE_E4M3=1. The kit's start.sh (r16z2) forwards it to BOTH ranks
#    and validates it (unset/e4m3/f16; the value needs the r16z2 overlay glm53_moe_e4m3.py that reads it).
#switch GLM53_MOE_E4M3_DOWN e4m3|f16
# -- operator switch (r16z3, moe3; docs/MOE3.md): NOT a line to add. apply_r16.sh never writes it, so it stays
#    unset = stock (production's own grouped kernels serve every eligible prefill call; the bundle does not run
#    patch_moe_fused16.py, so nothing of the feature reaches site-packages and the composed tree is the previous
#    kit's byte for byte). The kit's start.sh (r16z3) forwards it to BOTH ranks and validates it (empty/0/1; 1 also
#    needs overlay/tf/overlay/{patch_moe_fused16.py,glm53_moe_fused16.py,glm53_moe_e4m3_ext.cpython-312-
#    aarch64-linux-gnu.so} - the extension is the one GLM53_MOE_E4M3 shares - and a bundle script that
#    runs the patch); tools/env_r16.sh on fused16 writes GLM53_MOE_FUSED16=1 after checking that the installed
#    start.sh forwards it (an r16z2 start.sh does not: the line would be silently ignored); off removes it. 1 puts
#    every E3 grouped prefill call >= 4,096 tokens on the P16 schedules: production's arithmetic, h2 bit-identical,
#    -7.1..-7.7 ms per 13,824-token MoE layer call (the e4m3 damage is NOT taken; FUSED16 replaces e4m3 on any layer
#    whose GLM53_MOE_E4M3_LAYERS keeps it out).
#switch GLM53_MOE_FUSED16 0|1
# -- operator knob (r16z3, moe3; docs/MOE3.md): NOT a #switch (the value is a free-form comma list, which
#    apply_r16's enum check cannot parse). unset = every MoE layer runs the e4m3 path (unchanged); else a comma
#    list / ranges of the model's MoE layer indices (3..44; whitespace allowed, e.g. 13-44 or 3-12,23-44): only
#    those layers run e4m3, every other MoE layer stays on production's kernels (or the P16 ones with
#    GLM53_MOE_FUSED16=1). The e4m3 summary line names the selection ("K indices selected, U layers unselected").
#    Only read when GLM53_MOE_E4M3=1. The kit's start.sh (r16z3) forwards it to BOTH ranks and validates the syntax
#    and the index range against the model's MoE layers; the r16z3 boot_checks compare the two ranks' values and
#    expect the summary to serve exactly the listed layers.
#knob GLM53_MOE_E4M3_LAYERS unset|comma-list-of-MoE-layer-indices
# -- operator knob (r16z3, moe3; docs/MOE3.md): NOT a #switch (free-form comma list). unset = GLM53_MOE_E4M3_DOWN
#    decides the down-projection width for every layer (unchanged); else a comma list / ranges of MoE layer indices
#    (same syntax as GLM53_MOE_E4M3_LAYERS): exactly those layers run the down projection on fp16 (fused variant
#    16), every other served layer the e4m3 down. On the mini the early-layer f16 down removed as much KL as f16
#    everywhere at 3/7 of the cost. Only read when GLM53_MOE_E4M3=1. The kit's start.sh (r16z3) forwards it to BOTH
#    ranks and validates it like GLM53_MOE_E4M3_LAYERS; boot_checks compare the two ranks' values.
#knob GLM53_MOE_E4M3_DOWN_LAYERS unset|comma-list-of-MoE-layer-indices
# -- operator switch (r16z4, moe-opt; docs/OPT_MOE.md): NOT a line to add. apply_r16.sh never writes it, so it
#    stays unset = f32 (the fp32 accumulator, production's arithmetic). bf16 = the bf16 accumulator of the e4m3
#    routed-MoE prefill (the down epilogue adds bf16-rounded contributions with red.add.noftz.v4.bf16x2: -7.0 ms
#    per 13,824-token layer call, -0.71 s per 32k request; rel-L2 3.9e-3 vs the fp32 accumulator, distance to
#    production x1.003). DEFAULT OFF on purpose: the MoE refutation of opt-moe is still running and a rejection
#    arrives as a follow-up. Only read when GLM53_MOE_E4M3=1. The kit's start.sh (r16z4) forwards it to BOTH ranks
#    and validates it (unset/f32/bf16; the value needs the r16z4 overlay glm53_moe_e4m3.py that reads it).
#switch GLM53_MOE_E4M3_ACC f32|bf16
# -- operator switch (r16z4, moe-opt; docs/OPT_MOE.md): NOT a line to add; DEFAULT OFF. =1 accumulates the routed
#    sum straight into the shared experts' bf16 output (-2.05 ms per 13,824-token layer call) and REQUIRES
#    GLM53_MOE_E4M3_ACC=bf16 - the kit's start.sh refuses =1 without it BEFORE any rank is stopped (without the
#    bf16 accumulator the module refuses the whole e4m3 install, production's kernels gone for a dial). The
#    refuter still has this opt-moe feature open, like ACC. Only read when GLM53_MOE_E4M3=1.
#switch GLM53_MOE_E4M3_FOLD_SHARED 0|1
# -- operator switch (r16z4, moe-opt; docs/OPT_MOE.md): NOT a line to add; unset/1 = ON (the designed default,
#    numerically transparent: one gathered gate/up row per token when the layer's experts share the w13 suh,
#    bitwise the per-pair result; the e4m3 summary then reads "token gather 42/42 served layers"); 0 = the
#    per-pair gather (the revert lever, the summary reads "GLM53_MOE_E4M3_TOKGATHER=0 (per-pair gather)"). Only
#    read when GLM53_MOE_E4M3=1; the kit's start.sh forwards it to BOTH ranks and validates it.
#switch GLM53_MOE_E4M3_TOKGATHER 0|1
# -- operator switch (r16z4, mla-fused-index; docs/OPT_DENSE.md): NOT a line to add; unset/1 = ON (the deliberate
#    default change of this kit: ONE Triton pass writes production's kv_indices bytes AND the valid counts,
#    -2.7 ms per 13,824-token forward_mqa; the whole kv_indices buffer == production's, byte for byte, the
#    refuter's adv_fused_index suite); 0 = production's triton_convert + clamp + copy chain (THE REVERT LEVER the
#    operator sets by hand). Only read when GLM53_MLA_PREFILL=1, by the site glm53_mla_prefill.py this kit ships;
#    the start.sh refuses a value without that module (an older one would silently ignore =0).
#switch GLM53_MLA_PREFILL_FUSED_INDEX 0|1
# -- operator switch (r16z4, w8a8-fp8ag; docs/OPT_DENSE.md): NOT a line to add; DEFAULT OFF. =1 (only read when
#    GLM53_DENSE_W8A8=1) carries the sequence-parallel attention gather of a KDA layer whose in_proj_qkvbfg_a is
#    served as per-token fp8 + scales: HALF the gather bytes, the in_proj output bitwise the W8A8 result. A PAIRED
#    COLLECTIVE (per-layer CPU MIN vote over the TP group): a rank whose W8A8 install was refused never joins the
#    vote and its peer HANGS at the first sequence-parallel forward - boot_checks pair-gates the
#    "FP8 all-gather installed" line on BOTH ranks BEFORE every traffic check and treats the opt-dense-rev refusal
#    ERROR as a MISS. tools/env_r16.sh on fp8ag checks the prerequisites with .env unchanged on refusal.
#switch GLM53_DENSE_W8A8_FP8AG 0|1
# -- operator knob (r16z4, w8a8-hilo; docs/OPT_DENSE.md): NOT a #switch (the value is a free-form comma list).
#    unset = off (the W8A8 path as shipped); else a comma list of "<group>.<proj>:<channels>", channels a multiple
#    of 16 in 16..2048 - the e4m3 residual of those STABLE outlier input channels is appended as extra K columns of
#    the same GEMM (the W8A8 quality lever; the reviewed HA set is
#    kda.o_proj:256,shared.down_proj:128,dense.down_proj:512,mla.q_b_proj:256,mla.o_proj:512). draft.fc is NOT
#    accepted (NO-GO until its acceptance is measured). Needs the AOT tf_fp8_w8a8_ext built WITH REPACK_LD (this
#    kit's build). Only read when GLM53_DENSE_W8A8=1; the start.sh forwards it to BOTH ranks and validates every
#    entry; boot_checks compare the two ranks' values.
#knob GLM53_DENSE_W8A8_HILO unset|comma-list-of-<group>.<proj>:<channels>
# -- operator switch (r16z4, w8a8-hilo; docs/OPT_DENSE.md): NOT a line to add; unset/call = the hi+lo channel set
#    is re-picked per call; first = frozen at each layer's first real served call (the A/B mode, deterministic
#    after the first prompt). Only read when GLM53_DENSE_W8A8=1 with a GLM53_DENSE_W8A8_HILO value.
#switch GLM53_DENSE_W8A8_HILO_SEL call|first
# -- operator switch (r16z2x, mla-exactlens; docs/MLA_EXACT_LENS.md): NOT a line to add. apply_r16.sh never writes it,
#    so it stays unset = production's FA2 sparse-MLA plan (index_topk + ctx % kpool keys per row once ctx >=
#    index_topk, 4 more than the kpool indexer selects: every such decode row also attends slot-0 copies and the next
#    row's - or, for the last row of a step, a stale call's - keys). 1 = the exact counts (overlay
#    patch_mla_exactlens.py installs glm53_mla_exactlens.py and arms integrate.py; self-tested at the first build on
#    the image's real ops). Decode numerics change by design; prefill on the GLM53_MLA_PREFILL kernel does not.
#    The kit's start.sh (r16z5) forwards it to BOTH ranks and validates it (empty/0/1; 1 needs the two overlay files
#    and a bundle script that runs the patch); tools/env_r16.sh on|off exactlens. DEFAULT OFF (decode numerics
#    change by design: a deliberate knob, not a default change).
#switch GLM53_MLA_EXACT_LENS 0|1
# -- operator switch (r16z5, kdamhc; docs/KDAMHC.md): NOT a line to add. The MLA prefill kv_indices write-back:
#    unset = LIMITED (the deliberate default of this kit: only the rows an FA2 call can read beyond their own -
#    the install line says "first N rows"; ~-21 ms per 13,824-token chunk); 'all' = the r16 full write-back (the
#    revert lever); an integer N = an explicit row count. The rows kept are byte-identical to production's.
#    Only read when GLM53_MLA_PREFILL=1, by the site glm53_mla_prefill.py this kit ships; the start.sh forwards
#    it to BOTH ranks and validates it (all | integer).
#knob GLM53_MLA_PREFILL_KV_ROWS unset|all|row-count
# -- operator switch (r16z5, kdamhc; docs/KDAMHC.md): NOT a line to add; DEFAULT OFF. =1 -> the bundle overlay
#    patch_mhc_fused.py: the fused mHC post + prenorm-GEMM prefill kernel (residual_cur bitwise production's; the
#    24 mixing logits in the decode branch's fp32 arithmetic; the opt-kdamhc-rev rank-consistent fixed-seed
#    self-check at load). A PAIRED FEATURE: boot_checks' [mhcfused-pair] gate requires the applied line on BOTH
#    ranks BEFORE traffic (the mHC outputs feed the same all-reduce; a one-rank install = different mHC
#    arithmetic per rank). 1 needs overlay/tf/overlay/{patch_mhc_fused.py,glm53_mhc_fused.py,
#    glm53_mhc_fused_ext.cpython-312-aarch64-linux-gnu.so} and a bundle script that runs the patch.
#switch GLM53_MHC_FUSED 0|1
# -- operator switch (r16z5, kdamhc; docs/KDAMHC.md): NOT a line to add; unset/0 = the decode-consistent
#    rounding (the shipped default); 1 = the prefill-consistent rounding arm. Only read when GLM53_MHC_FUSED=1.
#switch GLM53_MHC_FUSED_ROUND_A 0|1
# -- operator knob (r16z5, kdamhc; docs/KDAMHC.md): NOT a #switch. unset = cfg 9 (BM16/HT64 + register prefetch);
#    else a decimal kernel cfg. Only read when GLM53_MHC_FUSED=1.
#knob GLM53_MHC_FUSED_CFG unset|decimal-cfg
# -- operator switch (r16z5, opt-decodekit; docs/MLA_EXACT_LENS.md): NOT a line to add; DEFAULT OFF. =1 -> the
#    exact-length FA2 sparse-MLA plan (overlay patch_mla_exactlens.py; decode numerics change by design, prefill
#    on the exact kernel does not). 1 needs overlay/tf/overlay/{patch_mla_exactlens.py,glm53_mla_exactlens.py}
#    and a bundle script that runs the patch; tools/env_r16.sh on|off exactlens.
#switch GLM53_MLA_EXACT_LENS 0|1
# -- operator knob (r16z5, w8a8layers; docs/OPT_W8A8LAYERS.md): NOT a #switch (free-form comma list). unset = no
#    layer excluded (the W8A8 path as shipped); else a comma list of '<layer>[:<name>]' with <layer> N or A-B
#    (0..4095) and <name> a served "<group>.<projection>", kda.f_b_proj / kda.g_b_proj, or a group
#    (kda|mla|dense|shared); applied AFTER GLM53_DENSE_W8A8_ONLY. A MALFORMED VALUE REFUSES THE W8A8 INSTALL
#    (production's dense FP8 path serves). The install line names the filter and the load summary counts
#    skip_layers_at_load. Only read when GLM53_DENSE_W8A8=1; the start.sh forwards it to BOTH ranks and
#    validates every entry; boot_checks compare the two ranks' values.
#knob GLM53_DENSE_W8A8_SKIP_LAYERS unset|comma-list-of-<layer>[:<name>]
# -- operator switch (r16z5, moe2-rev; docs/OPT_MOE2.md): NOT a line to add; DEFAULT OFF (SASS-identical to
#    opt-moe-rev for the shipped 24 kernels). =1 (only read when GLM53_MOE_E4M3=1) -> the lean fused mainloop:
#    fused variants + 8192, the same mma sequence and fragments, intermediates bitwise identical, -2.5 ms per
#    13,824-token layer call (static smem 2,064 B for the TG variants: 100,880 of 101,376 B per block). The value
#    needs the r16z5 overlay glm53_moe_e4m3.py that reads it.
#switch GLM53_MOE_E4M3_MAINLOOP 0|1
# -- operator knob (r16z6, opt-decode; docs/DEC_KDA_LAZY.md): NOT a #switch (the value is an integer). unset/0 = off
#    (stock: the KDA verify keeps production's per-row fp32 state stores); 1 = the site module glm53_kda_lazy.py:
#    ONE KDA recurrent-state store per verify step (an eager commit after sampling recomputes the accepted prefix
#    with production's arithmetic, bitwise; -1.6 ms/step at production's K mix on the nodeC step model, more with
#    concurrency; +51.7 MiB scratch per rank). Self-check dials (unset = the module defaults 64 / 1024, else a
#    non-negative integer; 0 = never): GLM53_DEC_KDA_LAZY_VERIFY (the first N commits checked) and
#    GLM53_DEC_KDA_LAZY_VERIFY_EVERY (then every N-th). The self-check compares fast vs production's kernel byte
#    for byte; a 'self-check: ... differ' line puts the commit in repair mode = exact but ~5 ms/step SLOWER ->
#    ROLLBACK TRIGGER, boot_checks treats it as a refusal. Only read when it is 1 by the site module this kit ships
#    (in site-packages on both ranks); the kit's start.sh forwards all three to BOTH ranks and validates them.
#knob GLM53_DEC_KDA_LAZY unset|0|1
# -- operator knob (r16z6, opt-decode; docs/DEC_KDA_LAZY.md): the kdalazy self-check dials above (free-form
#    non-negative integers, which the enum check cannot parse; unset = 64 / 1024, 0 = never).
#knob GLM53_DEC_KDA_LAZY_VERIFY unset|non-negative-integer
# -- operator knob (r16z6, opt-decode; docs/DEC_KDA_LAZY.md): see GLM53_DEC_KDA_LAZY_VERIFY.
#knob GLM53_DEC_KDA_LAZY_VERIFY_EVERY unset|non-negative-integer
# -- operator knob (r16z6, opt-decode; docs/OPT_DECODE.md 4): NOT a #switch (the value is an integer). unset/empty/0
#    = off (nothing recorded, outputs untouched); a positive integer N = the site module glm53_vtrim_stats.py, a
#    LOG-ONLY collector (~0.4 ms/step while on): 16 probabilities/counts per request and verify step (no token
#    ids) into a GPU ring written every N verify calls to GLM53_DEC_VTRIM_STATS_FILE (default
#    /root/.cache/vllm/glm53_vtrim_stats.npy, the bind-mounted vLLM cache dir). GLM53_DEC_VTRIM_STATS_CAP (a
#    positive integer, default 200000) sizes the ring; GLM53_DEC_VTRIM_STATS_FILE overrides the path. Calibration
#    data for the verify-trimming rule (an owner-go experiment: run a few hours, copy the .npy, evaluate with
#    tests/optdec/vtrim_policy_from_stats.py); the kit's start.sh
#    forwards all three to BOTH ranks and validates them.
#knob GLM53_DEC_VTRIM_STATS unset|0|flush-every-N-verify-calls
# -- operator knob (r16z6, opt-decode; docs/OPT_DECODE.md 4): the collector's ring capacity (free-form positive
#    integer, unset = 200000).
#knob GLM53_DEC_VTRIM_STATS_CAP unset|positive-integer
# -- operator knob (r16z6, opt-decode; docs/OPT_DECODE.md 4): the collector's output path (free-form path, unset =
#    /root/.cache/vllm/glm53_vtrim_stats.npy).
#knob GLM53_DEC_VTRIM_STATS_FILE unset|path
# -- operator knob (r16z6sv, decode4 track B; docs/SPEC_VTRIM.md): NOT a #switch (the values are an enum plus free-form
#    numbers). unset/empty/off/0 = production byte for byte; shadow = the site module glm53_spec_vtrim.py computes the
#    per-request stop n* from the DFlash2 selector's distributions and LOGS what trimming would do (outputs untouched);
#    on/1 = drafts after n* are not verified (the rejection sampler sees placeholders, the dead rows' routed experts
#    are skipped; exact at every temperature). Mode on refuses to start on a rank that cannot install the hooks. The
#    kit's start.sh forwards all four to BOTH ranks and validates them.
#knob GLM53_SPEC_VTRIM unset|off|0|shadow|on|1
# -- operator knob (r16z6sv; docs/SPEC_VTRIM.md): the survival threshold (free-form decimal in [0, 1], unset = 0.25).
#knob GLM53_SPEC_VTRIM_TAU unset|decimal-0-to-1
# -- operator knob (r16z6sv; docs/SPEC_VTRIM.md): minimum live drafts per step (0..7, unset = 0).
#knob GLM53_SPEC_VTRIM_MIN unset|0-7
# -- operator knob (r16z6sv; docs/SPEC_VTRIM.md): stats line period in verify steps (non-negative integer, unset = 2000;
#    the first line always comes after 64 steps).
#knob GLM53_SPEC_VTRIM_LOG unset|non-negative-integer
# -- operator switch (r16z7, prefixhit-adv; docs/PREFIX_HIT_TAIL.md, docs/DEPLOY_R16Z7.md): never added to .env, unset
#    = stock (the kpool indexer tail ring: every decode tail write past the first ring lands in ONE ring shared by all
#    running requests, and stale warm-up block ids overwrite pooled indexer keys of other requests / cached prefixes).
#    2 = the bundle overlay patch_kpool_tail_positions.py: per-request circular tail slots written into the persistent
#    slot-mapping buffer (FULL CUDA graph safe). The overlay's value 1 (positions only) is NOT accepted by the kit:
#    FULL decode graph replays never read it. Both ranks MUST carry the same value (the kit's start.sh forwards it to
#    both; boot_checks requires the patched lines on both): a one-rank fix silently degrades quality.
#switch GLM53_KPOOL_TAIL_POSITIONS 0|2
# -- operator switch (r16z7, prefixhit-adv; docs/PREFIX_HIT_TAIL.md): never added to .env, unset = stock. 1 = the bundle
#    overlay patch_mamba_align_seed.py: a prefix-hit / resumed request seeds its KDA running column in mamba blocks
#    (cache_config.mamba_block_size) instead of the engine core's recomputed cache_config.block_size (576 with the
#    DFlash2 group). Byte-identical behaviour in today's multiprocess workers (they keep 4608): hardening only.
#switch GLM53_MAMBA_ALIGN_SEED 0|1
# -- operator knob (r16z6ar, decode6; docs/DEC_AR1SHOT.md): NOT a #switch (an enum). unset/empty/0 = production byte
#    for byte; 1 = a decode-size all-reduce of the 2-rank TP group (<= _MAX_KB) runs as pynccl all_gather + one bf16
#    add (site module glm53_ar1shot.py): one network hop instead of the ring's two, the bf16 sum bit-identical;
#    verify = serve production's all-reduce and count the elements where the one-shot one would differ (log only,
#    one extra collective per all-reduce). A PAIRED collective: the kit's start.sh forwards all three to BOTH ranks
#    and validates them; boot_checks compares head and worker.
#knob GLM53_DEC_AR1SHOT unset|0|1|verify
# -- operator knob (r16z6ar; docs/DEC_AR1SHOT.md): the largest served tensor in KiB (integer 1..16384, unset = 512 =
#    64 decode rows x 4096 x bf16; larger all-reduces, e.g. prefill chunks, keep production's ring).
#knob GLM53_DEC_AR1SHOT_MAX_KB unset|integer-1-to-16384
# -- operator knob (r16z6ar; docs/DEC_AR1SHOT.md): stats line period in eager all-reduce calls (non-negative integer,
#    unset = 2000; the first line after 64).
#knob GLM53_DEC_AR1SHOT_LOG unset|non-negative-integer
# -- operator knob (r16z6dl, decode5; docs/DEC_DLMH.md): NOT a #switch (an enum). unset/empty/0 = production byte for
#    byte; 1 = the DFlash2 drafter's candidate head reads a 4-bit coarse copy of the lm_head (site module glm53_dlmh.py
#    + site/tf_dlmh_ext) and recomputes the EXACT FP8 logits of the coarse top-C column octets per row (byte-identical
#    candidates whenever those hold every element >= the 16th); verify = serve production's candidates and count the
#    rows where the two-stage head would differ (log only). The kit's start.sh forwards all four to BOTH ranks and
#    validates them.
#knob GLM53_DEC_DLMH unset|0|1|verify
# -- operator knob (r16z6dl; docs/DEC_DLMH.md): column octets rescored per row (multiple of 8 in 16..256, unset = 128).
#knob GLM53_DEC_DLMH_C unset|multiple-of-8-16-to-256
# -- operator knob (r16z6dl; docs/DEC_DLMH.md): coarse int4 group size along K (32|64|128, unset = 128).
#knob GLM53_DEC_DLMH_GROUP unset|32|64|128
# -- operator knob (r16z6dl; docs/DEC_DLMH.md): stats line period in drafter steps (non-negative integer, unset = 2000;
#    the first line after 64 steps).
#knob GLM53_DEC_DLMH_LOG unset|non-negative-integer
# -- operator knob (r16z8p; docs/MLA_PLAN_PIN.md): NOT a #switch (no env.r16 line). unset/empty/0 = production byte for
#    byte; 1 = production's sparse-MLA plan (_SM90State.plan of the launcher-mounted flashinfer_mla_sparse_sm90.py)
#    stages its indptr / lens in PAGE-LOCKED memory, a 2-slot ring with a per-slot CUDA event and its own page-locked
#    int workspace (site module glm53_mla_planpin.py): the 65540 B indptr copy at max-num-batched-tokens 16384 no
#    longer blocks the host until the drafter graph drained (~-1.1 ms/step), the device plan buffers get the same
#    bytes. The kit's start.sh forwards it to BOTH ranks and validates it; boot_checks compares head and worker.
#knob GLM53_MLA_PLAN_PIN unset|0|1
