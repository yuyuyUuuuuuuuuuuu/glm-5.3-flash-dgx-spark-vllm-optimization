+// K5 programmatic dependent launch (docs/OPTIMIZATION.md). pdl_wait: until the preceding kernel of the stream (the
+// programmatic primary) has completed and its writes are visible; pdl_trigger: this block allows the next kernel's
+// blocks to be launched. Both are no-ops for a kernel launched without the programmatic-stream-serialization
+// attribute. Rules followed by every kernel of the chain: pdl_wait before any read of data a predecessor wrote in
+// this call, before any global write, and before any exit (so no kernel can complete before its predecessor);
+// reads issued before pdl_wait touch only immutable data (weights, pointer tables) and the route tables written two
+// or more launches back, the latter with ld.global.cg (no stale L1 line from the previous call).
+__device__ __forceinline__ void pdl_wait() {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+#endif
+}
+__device__ __forceinline__ void pdl_trigger() {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+#endif
+}
