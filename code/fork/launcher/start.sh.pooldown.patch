 # [tf-exl3-fork] bundle: TensorFold EXL3 MoE kernels + resample-noise fix + drafter FP8 (inert unless its knobs are set)
 TF_BUNDLE_PATCH_HOST="${TF_BUNDLE_PATCH_HOST:-$SCRIPT_DIR/overlay/patch_tf_bundle.py}"
